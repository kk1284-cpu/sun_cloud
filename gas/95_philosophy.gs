// ============================================================
//  ドラッカーのコンセプト候補
//  ------------------------------------------------------------
//  社長からは「一覧はない」とご回答いただいたが、
//  **薬局の週次フォーム「週の完了日：一週間のGood！」に
//  『ドラッカー・ビタミン』という複数選択の設問が既にあり**、
//  そこに選択肢が入っている（時間管理／貢献する／集中する／
//  強みを活かす／意思決定する ほか）。これを候補の出発点にする。
//
//  あわせて大串さんがGCシートに実際に書かれた語も入れてある。
//  ⚠ 確定版ではない。フォームの選択肢を全部いただいて差し替える。
// ============================================================
var TK_DRUCKER = [
  // 薬局 週次フォーム「ドラッカー・ビタミン」の選択肢（判明分）
  '時間管理', '貢献する', '集中する', '強みを活かす', '意思決定する',
  // 大串さんがGCシートに記入されていた語（2026年4〜8月）
  '動機付け', '意思決定', '仕事のマネジメント', 'コミュニケーションは受け手'
];

// フィロソフィ名の正規化（表記ゆれを吸収して51項目に寄せる）
//  完全一致→部分一致→前方一致の順に見る。見つからなければ '' を返す（勝手に決めない）
function tkPhiloMatch_(raw) {
  var s = String(raw || '').replace(/[\s　。．、,]/g, '');
  if (!s) return '';
  var flat = function (t) { return String(t).replace(/[\s　。．、,]/g, ''); };
  var hit = '';
  TK_PHILOSOPHY.forEach(function (p) {
    var n = flat(p.name);
    if (n === s) hit = p.name;
  });
  if (hit) return hit;
  TK_PHILOSOPHY.forEach(function (p) {
    var n = flat(p.name);
    if (!hit && (n.indexOf(s) === 0 || s.indexOf(n) === 0)) hit = p.name;
  });
  return hit;
}

// 一覧をログに出す（確認用）
function tkフィロソフィ一覧() {
  var lines = ['=== 有限会社髙村 フィロソフィ ' + TK_PHILOSOPHY.length + '項目 ==='];
  [1, 2].forEach(function (w) {
    lines.push('');
    lines.push('【週' + w + '】');
    TK_PHILOSOPHY.filter(function (p) { return p.week === w; })
      .forEach(function (p) { lines.push('  ' + p.no + '. ' + p.name); });
  });
  lines.push('');
  lines.push('ドラッカーのコンセプト候補（暫定 ' + TK_DRUCKER.length + '件）: ' + TK_DRUCKER.join('／'));
  var msg = lines.join('\n');
  Logger.log(msg);
  return msg;
}
