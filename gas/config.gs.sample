// ============================================================
// gas_takamura ／ 有限会社高村（SUNグループ）日報解析システム
// ------------------------------------------------------------
//  自己完結型パッケージ。高村（甲）の Google Workspace 上で稼働させる想定。
//  クローバ側の共有バックエンド（SS_ID / MCQバックエンド）には一切依存しない。
//  （契約第7条：日報解析は甲のWorkspace内で処理／第8条：成果物は甲に帰属）
//
//  全体フロー:
//    日報フォーム → 回答シート
//       └▶ onFormSubmit → Geminiが「サンクスUP評価基準」で分類 →「分類済み」
//             └▶「活動記録」へ追記（EXP付与）         ＝ マンダラOKR反映の土台
//                   ├▶ OKR反映ビュー（部署×成果/能力/姿勢の到達マンダラ）
//                   └▶ 週次「応援（がんばり賞賛）」自動抽出（下書き→確認→送信）
//             └▶ 月次 日報解析レポート自動生成（契約第5条）
//
//  ★ 高村Workspaceでのセットアップ手順は README_導入手順.md を参照。
//     プロビジョニング後、下の ▼要設定 を埋めること。
// ============================================================

// ---------- 秘密設定（gas_nippo / gas_houkan と同じ方式） ----------
var SECRET_CONFIG = {
  // ▼要設定：Gemini APIキー（カンマ区切りで複数可＝429時フォールバック）
  GEMINI_API_KEYS: '',
  GEMINI_MODEL: 'gemini-flash-latest',
  // ▼要設定：Webアプリ用トークン（?key= で照合。任意の推測されにくい文字列）
  APP_TOKEN: 'CHANGE_ME'
};

// ---------- 高村システム設定 ----------
var TK = {
  // 会社名（メール件名・到達マンダラの見出しに出る）
  COMPANY: '有限会社高村（SUNグループ）',

  // ▼本システムのメインSS（「SUN日報解析」）のID。
  //   稼働中インスタンス（2026-07-24 貼付導入・スタンドアロン自動生成）
  SS_ID: '1Pg_3q14PPHMEePmzleMeD9xCNJRO8gSn2pNGSNAXHdg',

  // 日報が届いた瞬間にGeminiで判定するか。
  //   Geminiの無料枠は「1日20回」。1件ずつ判定すると日報15件で使い切り、
  //   その日の21件目から分類が止まる（＝トライアルで確実に踏む）。
  //   false にして送信時の判定をやめ、1時間ごとの「キャッチアップ」が
  //   15件まとめて1回のAPI呼び出しで処理する（1日1〜2回に圧縮）。
  //   → 導入後に tkキャッチアップ_設定() を1回だけ実行すること。
  CLASSIFY_ON_SUBMIT: false,

  // シート名（SETUP時に自動作成）
  SHEET_RAW:      '回答',        // 日報フォームのリンク回答（Formがヘッダを作る）
  SHEET_QUEST:    'クエスト表',   // サンクスUP評価基準（分類の基準）
  SHEET_CLASS:    '分類済み',     // Gemini分類の着地点（人が修正可能）
  SHEET_ACT:      '活動記録',     // OKR/応援の共通フィード（分類済みから追記）
  SHEET_MEMBER:   'メンバー',     // スタッフ名簿（メール→氏名・部署・配信停止）
  SHEET_OKR:      'OKR集計',      // 部署×観点の到達マンダラ集計（自動再計算）
  SHEET_LOG:      '実行ログ',     // バッチ実行の記録

  // 回答シート（フォーム）の列インデックス（0始まり）
  //   フォーム項目: [タイムスタンプ, メール, 氏名, 部署, 今日の実践・気づき]
  RAW_TS: 0, RAW_EMAIL: 1, RAW_NAME: 2, RAW_DEPT: 3, RAW_BODY: 4,

  // 部署（サンクスUP評価基準の部署軸）
  DEPTS: ['輝らら', 'サンフラワーズ', '本部', '薬局・ネットワーク'],
  // 評価の3観点（マンダラOKRの「成果・能力・姿勢」に対応）
  AXES: ['成果', '能力', '姿勢'],

  // EXP付与ルール（確信度に応じて）
  EXP: { 高: 10, 中: 6, 低: 3, none: 1 },

  // ▼管理者メール（下書き通知・レポート配信先）。空ならデプロイ実行者。
  ADMIN_EMAIL: 'kk1284@takamura-sunsun.com',   // 加藤さん

  // 応援（賞賛）メールのキャラ名（自己完結・任意）
  PRAISE_CHARA: 'サンクス先生',

  TZ: 'Asia/Tokyo'
};

// テーマ観点 → マンダラの並び（成果=上段/能力=中段/姿勢=下段のイメージ）
var AXIS_ORDER = { '成果': 0, '能力': 1, '姿勢': 2 };
